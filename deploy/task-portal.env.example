# Server-side environment for the Task Portal.
# Install as /etc/task-portal.env  (chmod 640, owned by root:deploy).
# Deployments NEVER write this file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=task_portal
DB_PASSWORD=CHANGE_ME
DB_NAME=task_portal

# Attachments live outside the deploy directory so releases can never delete them.
UPLOAD_DIR=/var/lib/task-portal/uploads

# Generate once with:  openssl rand -hex 32
# SESSION_SECRET: changing it signs everybody out.
# DATA_KEY:       changing it makes every stored Info credential permanently unreadable.
#                 Set these once, back them up, never rotate them casually.
SESSION_SECRET=CHANGE_ME
DATA_KEY=CHANGE_ME

# The app is served over HTTPS by nginx, so session cookies must be secure.
COOKIE_SECURE=1

NODE_ENV=production
PORT=3000
